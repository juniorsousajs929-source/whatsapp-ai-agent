# === CONFIGURAÇÃO DO SERVIDOR ===
PORT=3000

# === TOKEN EXCLUSIVO DO MANYCHAT ===
# Pegue esse token em: Settings -> API -> Generate Token
MANYCHAT_API_TOKEN=seu_token_aqui

# === ROTAÇÃO DE CHAVES GEMINI (Google AI) ===
# Você pode colocar várias chaves separadas por vírgula para evitar bloqueios.
# Pegue em: https://aistudio.google.com/app/apikey
GEMINI_KEYS=chave_1,chave_2,chave_3

# === INTEGRAÇÃO MANYCHAT (TOKENS POR BOT) ===
# Se você tiver múltiplos bots, configure os tokens aqui.
# Se só tiver um, use o MANYCHAT_TOKEN_ZAP1
MANYCHAT_TOKEN_ZAP1=seu_token_zap1
MANYCHAT_TOKEN_ZAP2=
MANYCHAT_TOKEN_ZAP3=
MANYCHAT_TOKEN_ZAP4=
MANYCHAT_TOKEN_ZAP5=
MANYCHAT_TOKEN_ZAP6=
